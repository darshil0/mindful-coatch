# Live AI (server-side only; never expose keys in client VITE_* variables)
# Falls back to GOOGLE_API_KEY or API_KEY if GEMINI_API_KEY is unset.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional hosting URL metadata injected by deployment platforms
APP_URL="MY_APP_URL"

# Reverse proxy configuration for client IP resolution ("false" by default).
# Supports "false", hop count 1..5, "loopback", "linklocal", "uniquelocal", or comma-separated proxy IPs/CIDRs.
# Blanket "true" is rejected to prevent X-Forwarded-For rate-limit spoofing.
TRUST_PROXY="false"

# Optional Gemini failover models and thinking-level capability allowlist
GEMINI_MODELS="gemini-4-hydrogen,gemini-3.1-flash-lite"
GEMINI_THINKING_MODELS="gemini-4-hydrogen"

# Production HTTP security headers (Helmet CSP enforces self-hosted assets)
ENABLE_HSTS="false"
CSP_FRAME_ANCESTORS=""

# Server resource bounds for Live AI coaching requests
COACH_MAX_CONCURRENCY="4"
COACH_MAX_QUEUE="12"
COACH_GLOBAL_RPM="120"
COACH_GLOBAL_CHAR_BUDGET_PER_MIN="400000"

# ?autostart=1 is enabled in dev builds automatically; keep false in production unless running browser smoke tests
VITE_ENABLE_TEST_AUTOSTART="false"
