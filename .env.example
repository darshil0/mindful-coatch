# GEMINI_API_KEY: Required for Live AI Gemini calls (server also falls back to GOOGLE_API_KEY or API_KEY).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional hosting URL injected by deployment environments (not required for local development).
APP_URL="MY_APP_URL"
